#include "Cell.hlsl"
#include "Helpers.hlsl"

RWStructuredBuffer<uint2> bond_cells;
RWStructuredBuffer<float4> bond_rest; // xyz = rest_dir, w = rest_distance
RWStructuredBuffer<cell> cells;
RWStructuredBuffer<uint> force_buffer; // 3 uints per cell (x,y,z)
RWStructuredBuffer<float3> velocities;
RWStructuredBuffer<uint> bucket_check;
RWStructuredBuffer<uint> bucket_end;
RWStructuredBuffer<uint> bucket_start;
RWStructuredBuffer<uint> cell_count; // [0] = alive cell count
RWStructuredBuffer<uint> cell_full_hash;  // full hash (verification)
RWStructuredBuffer<uint> cell_indices;
RWStructuredBuffer<uint> cell_table_keys; // masked hash (sort key)
RWTexture3D<float> sdf_brick_atlas;
RWTexture3D<uint> sdf_brick_index;
RWStructuredBuffer<uint> sdf_brick_counter;
StructuredBuffer<uint> bucket_check_ro;
StructuredBuffer<uint> bucket_end_ro;
StructuredBuffer<uint> bucket_start_ro;
StructuredBuffer<cell> cells_ro;
StructuredBuffer<uint> cell_full_hash_ro;
StructuredBuffer<uint> cell_indices_ro;

float bond_bend_stiffness;
float bond_linear_stiffness;
float bond_range_sq;
float bucket_size;
float cell_radius;
float delta_time;
float damping;
float3 gravity;
float neighbor_radius;
float neighbor_radius_sq;
float repulsion_strength;
float time;
float wind_frequency;
float wind_speed;
float wind_strength;
float wind_variation;
float3 wind_direction;
float3 bounds_max;
float3 bounds_min;
int max_bonds_per_cell;
uint bucket_table_size;
uint max_bonds;
uint max_cells;
float sdf_max_distance;
uint3 sdf_bucket_dim;
uint3 sdf_sample_dim;
uint3 sdf_brick_dim;
uint3 sdf_atlas_brick_dim;
int3 sdf_bucket_min;
uint sdf_max_bricks;
uint sdf_samples_per_bucket;

float encode_sdf(float dist)
{
    return saturate((dist + sdf_max_distance) / (2.0 * sdf_max_distance));
}

float3 wind_force(float3 position)
{
    if (wind_strength <= 1e-6)
        return float3(0, 0, 0);

    float3 dir = safe_normalize(wind_direction);
    float3 phase = position * wind_frequency + time * wind_speed;
    float base_wave = sin(phase.x + phase.y + phase.z);
    float3 cross_wave = float3(
        sin(phase.y * 1.7 + phase.z * 0.9),
        sin(phase.z * 1.3 + phase.x * 1.1),
        sin(phase.x * 1.5 + phase.y * 0.7)
    );

    float3 wind = dir * base_wave + cross_wave * wind_variation;
    return wind * wind_strength;
}

uint active_count()
{
    return min(cell_count[0], max_cells);
}

void add_interlocked_float(RWStructuredBuffer<uint> buffer, uint index, float value)
{
    uint expected = buffer[index];
    uint original;

    while (true)
    {
        float current = asfloat(expected);
        uint desired = asuint(current + value);
        InterlockedCompareExchange(buffer[index], expected, desired, original);
        if (original == expected)
        {
            return;
        }
        expected = original;
    }
}

void add_force(uint id, float3 force)
{
    uint base_index = id * 3;
    add_interlocked_float(force_buffer, base_index, force.x);
    add_interlocked_float(force_buffer, base_index + 1, force.y);
    add_interlocked_float(force_buffer, base_index + 2, force.z);
}

#pragma kernel prepare_indirect_args

RWStructuredBuffer<uint> indirect_args; // { threadGroupsX, threadGroupsY, threadGroupsZ }

[numthreads(1, 1, 1)]
void prepare_indirect_args(uint3 id : SV_DispatchThreadID)
{
    uint count = active_count();
    cell_count[0] = count;
    indirect_args[0] = (count + 63) / 64;
    indirect_args[1] = 1;
    indirect_args[2] = 1;
}

bool should_split(cell c, uint id, float time)
{
    const float split_age = 0.02;
    return c.age >= split_age && (c.age - delta_time) < split_age;
}

cell make_child(cell parent, uint id)
{
    cell child;
    child.age = 0;
    float3 dir = safe_normalize(parent.polarity);
    float3 jitter = float3(
        random(id * 44317) - 0.5,
        random(id * 3231) - 0.5,
        random(id * 432457) - 0.5
    );
    dir = safe_normalize(dir + jitter * 0.2);
    float spacing = sqrt(bond_range_sq) * 0.9;
    child.position = parent.position + dir * spacing;
    child.polarity = dir;
    return child;
}

#pragma kernel grow

[numthreads(64, 1, 1)]
void grow(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    
    cell c = cells[id];
    
    // Skip dead cells
    if (c.age < 0) return;
    
    c.age += delta_time;

    // Write back updated cell
    cells[id] = c;
    
    // Try to split
    if (should_split(c, id, time) && count < max_cells * 0.95)
    {
        uint child_idx;
        InterlockedAdd(cell_count[0], 1, child_idx);

        // Could get counter drift if this is out of range and doesn't make a child but has already incremented
        // counter. Resolved in finalize compact.
        if (child_idx < max_cells)
        {
            cell child = make_child(c, id);
            cells[child_idx] = child;
            velocities[child_idx] = float3(0, 0, 0);
        }
    }
}

#pragma kernel compact_cells

RWStructuredBuffer<uint> compact_count; // temp counter for compaction
RWStructuredBuffer<uint> cell_remap;    // old index -> new index mapping

[numthreads(64, 1, 1)]
void compact_cells(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    
    cell c = cells[id];
    
    // If alive, claim a spot in compacted array
    if (c.age >= 0)
    {
        uint new_idx;
        InterlockedAdd(compact_count[0], 1, new_idx);
        cell_remap[id] = new_idx;
    }
    else
    {
        cell_remap[id] = 0xffffffff; // mark as dead
    }
}

#pragma kernel write_compacted

RWStructuredBuffer<cell> cells_temp;
RWStructuredBuffer<float3> velocities_temp;

[numthreads(64, 1, 1)]
void write_compacted(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    
    uint new_idx = cell_remap[id];
    
    if (new_idx != 0xffffffff)
    {
        cells_temp[new_idx] = cells[id];
        velocities_temp[new_idx] = velocities[id];
    }
}

#pragma kernel remap_bonds

[numthreads(64, 1, 1)]
void remap_bonds(uint id : SV_DispatchThreadID)
{
    if (id >= max_cells) return;
    
    uint bond_start = id * max_bonds_per_cell;
    uint bond_end = min(bond_start + max_bonds_per_cell, max_bonds);
    
    for (uint i = bond_start; i < bond_end; i++)
    {
        uint2 cells_pair = bond_cells[i];
        uint cell_a = cells_pair.x;
        
        // Skip invalid bonds
        if (cell_a == 0xffffffff) break;
        
        // Get new indices for both cells
        uint new_a = cell_remap[cell_a];
        uint new_b = cell_remap[cells_pair.y];
        
        // If either cell was deleted, invalidate the bond
        if (new_a == 0xffffffff || new_b == 0xffffffff)
        {
            bond_cells[i] = uint2(0xffffffff, 0xffffffff);
            bond_rest[i] = float4(0, 0, 0, 0);
        }
        else
        {
            // Update to new indices
            bond_cells[i] = uint2(new_a, new_b);
        }
    }
}

#pragma kernel copy_back

[numthreads(64, 1, 1)]
void copy_back(uint id : SV_DispatchThreadID)
{
    if (id >= compact_count[0]) return;
    cells[id] = cells_temp[id];
    velocities[id] = velocities_temp[id];
}

#pragma kernel finalize_compact

[numthreads(1, 1, 1)]
void finalize_compact(uint3 id : SV_DispatchThreadID)
{
    cell_count[0] = min(compact_count[0], max_cells);
    compact_count[0] = 0; // reset for next compaction
}

#pragma kernel clear_buckets

[numthreads(64, 1, 1)]
void clear_buckets(uint id : SV_DispatchThreadID)
{
    if (id >= bucket_table_size) return;
    bucket_start[id] = 0xffffffff;
    bucket_end[id] = 0;
    bucket_check[id] = 0;
}

#pragma kernel build_spatial_hash

[numthreads(64, 1, 1)]
void build_spatial_hash(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    if (bucket_size <= 1e-6) return;
    
    cell c = cells[id];
    
    int3 bucket_coord = floor(c.position / bucket_size);
    uint bucket_hash = fast_hash_coord(bucket_coord);
    uint bucket_index = bucket_hash & (bucket_table_size - 1);

    cell_full_hash[id] = bucket_hash;
    cell_table_keys[id] = bucket_index;
    cell_indices[id] = id;
    
    // each cell sets all buckets it could possibly influence to check = 1
    // this is useful when stepping through the buckets for density sampling etc. as we can early-out very efficiently
    bucket_check[bucket_index] = 1;
    for (uint i = 0; i < 26; i++)
    {
        int3 influence_coord = bucket_coord + bucket_offsets_no_center[i];
        bucket_hash = fast_hash_coord(influence_coord);
        bucket_index = bucket_hash & (bucket_table_size - 1);
        
        bucket_check[bucket_index] = 1;
    }
}

#pragma kernel build_bucket_ranges

// ENSURE HASHES ARE SORTED WITH RADIX SORT BEFORE RUNNING BUILD BUCKET RANGES
[numthreads(64, 1, 1)]
void build_bucket_ranges(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;

    uint key = cell_table_keys[id];
    uint prev_key = id > 0 ? cell_table_keys[id - 1] : 0xffffffff;
    uint next_key = (id < count - 1) ? cell_table_keys[id + 1] : 0xffffffff;

    // First element of this bucket
    if (id == 0 || key != prev_key)
    {
        bucket_start[key] = id;
    }
    
    // Last element of this bucket (exclusive end)
    if (id == count - 1 || key != next_key)
    {
        bucket_end[key] = id + 1; // exclusive end
    }
}

#pragma kernel apply_collision_forces

[numthreads(64, 1, 1)]
void apply_collision_forces(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    if (bucket_size <= 1e-6) return;
    if (neighbor_radius <= 1e-6) return;

    cell c = cells[id];
    
    // Skip dead cells
    if (c.age < 0) return;
    
    // Spatial hash repulsion
    int3 base_bucket = floor(c.position / bucket_size);

    uint alive_count = count;
    
    float3 accel = float3(0, 0, 0);
    
    for (int z = -1; z <= 1; z++)
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                int3 nb = base_bucket + int3(x, y, z);
                uint hash = fast_hash_coord(nb);
                uint bucket = hash & (bucket_table_size - 1);

                uint start = bucket_start[bucket];
                uint end = bucket_end[bucket];
                
                if (start == 0xffffffff || start >= end) continue;

                for (uint i = start; i < end; i++)
                {
                    if (i >= alive_count) continue;
                    
                    // Verify full hash
                    if (cell_full_hash[cell_indices[i]] != hash)
                        continue;
                    
                    uint other_id = cell_indices[i];
                    if (other_id == id) continue;

                    cell other = cells[other_id];
                    
                    // Skip if other is dead
                    if (other.age < 0) continue;

                    float3 delta = c.position - other.position;
                    float dist_sq = dot(delta, delta);

                    if (dist_sq > neighbor_radius_sq || dist_sq < 1e-6)
                        continue;

                    float inv_dist = rsqrt(dist_sq);
                    float3 dir = delta * inv_dist;
                    float dist = dist_sq * inv_dist;
                    float t = 1.0 - (dist / neighbor_radius);
                    float force = repulsion_strength * t * t;

                    accel += dir * force;
                }
            }
    
    add_force(id, accel);
}

#pragma kernel apply_bond_forces

[numthreads(64, 1, 1)]
void apply_bond_forces(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    
    cell c = cells[id];
    if (c.age < 0) return;
    
    uint bond_start = id * max_bonds_per_cell;
    uint bond_end   = min(bond_start + max_bonds_per_cell, max_bonds);
    
    for (uint i = bond_start; i < bond_end; i++)
    {
        uint2 cells_pair = bond_cells[i];
        uint cell_a = cells_pair.x;
        if (cell_a == 0xffffffff) break; // invalid bond
        if (cell_a != id) continue;
        
        uint cell_b = cells_pair.y;
        if (cell_b >= count) continue;
        cell other = cells[cell_b];
        if (other.age < 0) continue;
        
        float3 delta = other.position - c.position;
        float dist_sq = dot(delta, delta);
        if (dist_sq < 1e-6) continue;

        float inv_dist = rsqrt(dist_sq);
        float dist = dist_sq * inv_dist;
        float3 dir = delta * inv_dist;   // current bond direction

        // Linear stiffness
        float4 rest = bond_rest[i];
        float diff = dist - rest.w;
        float3 bond_force = dir * (diff * bond_linear_stiffness);

        // Rotational stiffness
        // angular error axis (≈ sin(theta) * axis)
        float3 axis = cross(dir, rest.xyz);

        // convert angular error → lateral force
        float3 rot_force = cross(axis, dir);
        
        // TODO: make this a param
        float angular_damp = 0.1;
        rot_force -= angular_damp * axis;

        bond_force += rot_force * bond_bend_stiffness;

        add_force(id, bond_force);
        add_force(cell_b, -bond_force);
    }
}

#pragma kernel resolve_force_buffer

[numthreads(64, 1, 1)]
void resolve_force_buffer(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;

    uint base_index = id * 3;
    float3 force = float3(
        asfloat(force_buffer[base_index]),
        asfloat(force_buffer[base_index + 1]),
        asfloat(force_buffer[base_index + 2])
    );

    // Clear buffer for next frame.
    force_buffer[base_index] = 0;
    force_buffer[base_index + 1] = 0;
    force_buffer[base_index + 2] = 0;

    cell c = cells[id];
    if (c.age < 0) return;

    float3 accel = force + gravity + wind_force(c.position);
    float3 v = velocities[id];
    v += accel * delta_time;
    v *= exp(-damping * delta_time);

    c.position += v * delta_time;
    float3 clamped = clamp(c.position, bounds_min + cell_radius, bounds_max - cell_radius);
    if (any(c.position != clamped))
    {
        float3 hit = step(clamped + 1e-6, c.position) + step(c.position, clamped - 1e-6);
        v *= 1.0 - hit;
        c.position = clamped;
    }
    velocities[id] = v;
    cells[id] = c;
}

#pragma kernel init_bonds

[numthreads(64, 1, 1)]
void init_bonds(uint id : SV_DispatchThreadID)
{
    if (id >= max_bonds) return;
    
    bond_cells[id] = uint2(0xffffffff, 0xffffffff);
    bond_rest[id] = float4(0, 0, 0, 0);
}

#pragma kernel add_bonds
#pragma kernel build_sdf_bricks
#pragma kernel clear_sdf_index

// assymetric bonds :(
[numthreads(64, 1, 1)]
void add_bonds(uint id : SV_DispatchThreadID)
{
    uint count = active_count();
    if (id >= count) return;
    if (bucket_size <= 1e-6) return;
    
    cell c = cells[id];
    
    // Skip dead cells
    if (c.age < 0) return;
    
    int3 base_bucket = floor(c.position / bucket_size);
    
    uint alive_count = count;
    
    int num_bonds_generated = 0;
    uint bond_start_id = id * max_bonds_per_cell;
    
    uint seed = wang_hash(id);
    uint offset = seed % 27;
    
    for (uint k = 0; k < 27; k++)
    {
        int3 nb = base_bucket + bucket_offsets[(k + offset) % 27];
        uint hash = fast_hash_coord(nb);
        uint bucket = hash & (bucket_table_size - 1);

        uint start = bucket_start[bucket];
        uint end = bucket_end[bucket];
                
        if (start == 0xffffffff || start >= end) continue;

        for (uint i = start; i < end; i++)
        {
            if (bond_cells[bond_start_id + num_bonds_generated].x != 0xffffffff) continue;
            if (i >= alive_count) continue;
                    
            // Verify full hash
            if (cell_full_hash[cell_indices[i]] != hash)
                continue;
                    
            // Avoid self
            uint other_id = cell_indices[i];
            if (other_id == id) continue;

            cell other = cells[other_id];
                    
            // Skip if other is dead
            if (other.age < 0) continue;

            float3 delta = other.position - c.position;
            float dist_sq = dot(delta, delta);

            if (dist_sq > bond_range_sq || dist_sq < 1e-6)
                continue;
            
            float inv_dist = rsqrt(dist_sq);
            float3 dir = delta * inv_dist;
            uint write_index = bond_start_id + num_bonds_generated;
            bond_cells[write_index] = uint2(id, other_id);
            bond_rest[write_index] = float4(dir, dist_sq * inv_dist);
                    
            num_bonds_generated++;
            
            if (num_bonds_generated >= max_bonds_per_cell)
            {
                return;
            }
        }
    }
    
    
}

[numthreads(4, 4, 4)]
void clear_sdf_index(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= sdf_brick_dim.x || id.y >= sdf_brick_dim.y || id.z >= sdf_brick_dim.z)
        return;
    sdf_brick_index[id] = 0;
}

groupshared uint g_has_data;
groupshared uint g_brick_index;
groupshared float g_samples[512];

[numthreads(8, 8, 8)]
void build_sdf_bricks(uint3 id : SV_DispatchThreadID, uint3 group_id : SV_GroupID, uint3 group_thread_id : SV_GroupThreadID)
{
    if (group_id.x >= sdf_brick_dim.x || group_id.y >= sdf_brick_dim.y || group_id.z >= sdf_brick_dim.z)
        return;

    if (group_thread_id.x == 0 && group_thread_id.y == 0 && group_thread_id.z == 0)
    {
        g_has_data = 0;
        g_brick_index = 0xffffffff;
    }
    GroupMemoryBarrierWithGroupSync();

    float encoded_max = 1.0;
    float encoded = encoded_max;

    if (bucket_size > 1e-6 && sdf_max_distance > 1e-6 && sdf_samples_per_bucket > 0)
    {
        int3 sample_coord = (int3)(group_id * 8 + group_thread_id);
        if (sample_coord.x < (int)sdf_sample_dim.x &&
            sample_coord.y < (int)sdf_sample_dim.y &&
            sample_coord.z < (int)sdf_sample_dim.z)
        {
            float3 sample_bucket_pos = (float3)sample_coord / (float)sdf_samples_per_bucket;
            int3 base_bucket_coord = sdf_bucket_min + (int3)floor(sample_bucket_pos);
            float3 p = (float3)sdf_bucket_min * bucket_size + sample_bucket_pos * bucket_size;

            float min_dist = sdf_max_distance;

            for (int dz = -1; dz <= 1; dz++)
                for (int dy = -1; dy <= 1; dy++)
                    for (int dx = -1; dx <= 1; dx++)
                    {
                        int3 bucket_coord = base_bucket_coord + int3(dx, dy, dz);
                        int3 local_coord = bucket_coord - sdf_bucket_min;
                        if (local_coord.x < 0 || local_coord.y < 0 || local_coord.z < 0 ||
                            local_coord.x >= (int)sdf_bucket_dim.x ||
                            local_coord.y >= (int)sdf_bucket_dim.y ||
                            local_coord.z >= (int)sdf_bucket_dim.z)
                        {
                            continue;
                        }

                        uint hash = fast_hash_coord(bucket_coord);
                        uint bucket = hash & (bucket_table_size - 1);
                        if (!bucket_check_ro[bucket])
                            continue;

                        uint start = bucket_start_ro[bucket];
                        uint end = bucket_end_ro[bucket];
                        if (start == 0xffffffff || start >= end) continue;

                        for (uint i = start; i < end; i++)
                        {
                            uint idx = cell_indices_ro[i];
                            if (cell_full_hash_ro[idx] != hash || cells_ro[idx].age < 0) continue;

                            float3 diff = p - cells_ro[idx].position;
                            float dist = length(diff) - cell_radius;
                            min_dist = min(min_dist, dist);
                        }
                    }

            encoded = encode_sdf(min_dist);
            if (encoded < encoded_max)
            {
                InterlockedOr(g_has_data, 1);
            }
        }
    }

    uint local_index = group_thread_id.x + group_thread_id.y * 8 + group_thread_id.z * 64;
    g_samples[local_index] = encoded;

    GroupMemoryBarrierWithGroupSync();

    if (group_thread_id.x == 0 && group_thread_id.y == 0 && group_thread_id.z == 0)
    {
        if (g_has_data != 0)
        {
            uint idx;
            InterlockedAdd(sdf_brick_counter[0], 1, idx);
            if (idx < sdf_max_bricks)
            {
                g_brick_index = idx;
                sdf_brick_index[group_id] = idx + 1;
            }
            else
            {
                g_brick_index = 0xffffffff;
                sdf_brick_index[group_id] = 0;
            }
        }
        else
        {
            sdf_brick_index[group_id] = 0;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    if (g_brick_index == 0xffffffff)
        return;

    int3 atlas_brick_coord = index_to_coord_3d(g_brick_index, sdf_atlas_brick_dim);
    uint3 atlas_coord = (uint3)(atlas_brick_coord * 8 + (int3)group_thread_id);
    sdf_brick_atlas[atlas_coord] = g_samples[local_index];
}
