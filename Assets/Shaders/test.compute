#pragma enable_dxc
#pragma target 6.5
#pragma multi_compile __ UNITY_DEVICE_SUPPORTS_WAVE_32 UNITY_DEVICE_SUPPORTS_WAVE_64

// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

[numthreads(32,1,1)]
void CSMain(uint3 DTID : SV_DispatchThreadID)
{
    uint lane = WaveGetLaneCount();
}