#include "Cell.hlsl"

StructuredBuffer<uint> cell_count;
StructuredBuffer<cell> cells_in;
AppendStructuredBuffer<cell> cells_out;

uint max_cells;
float3 bounds_min;
float3 bounds_max;
float time;
float delta_time;
float4 new_colour;
float4 death_colour;
float3 camera_pos;
float3 camera_forward;

uint hash(uint s)
{
    s ^= 2747636419u;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    return s;
}

float random(uint seed)
{
    return float(hash(seed)) / 4294967295.0;
}

uint hash_coord(int3 coord)
{
    return (uint)(coord.x * 73856093) ^
        (uint)(coord.y * 19349663) ^
        (uint)(coord.z * 83492791);
}

bool should_split(cell c, uint id)
{
    float r = random(id + (uint)(time * 1000));
    float agePenalty = exp(-c.age * 0.5); // Rapid dropoff
    return r < 0.05 * agePenalty;
}

bool should_die(cell c, uint id)
{
    float r = random(id + (uint)(time * 1000) + 12345); // decorrelate
    float age_factor = 1.0 - exp(-c.age * 0.5); // 0 → 1 as age increases
    return r < 0.05 * age_factor;
}

cell make_child(cell parent, uint id)
{
    cell child;
    child.age = 0;
    child.color = new_colour;
    float3 offset = float3(
        random(id * 44317) - 0.5,
        random(id * 3231) - 0.5,
        random(id * 432457) - 0.5
    );
    child.position = parent.position + offset * 0.5;
    return child;
}

#pragma kernel grow

[numthreads(256, 1, 1)]
void grow(uint id : SV_DispatchThreadID)
{
    if (id >= max_cells) return;
    
    if (id >= cell_count[0]) return;
    
    cell parent = cells_in[id];
    
    parent.age += delta_time;

    if (should_die(parent, id)) return;
    
    float age_factor = exp(-parent.age * 1);
    parent.color = lerp(death_colour, new_colour, age_factor);
    
    cells_out.Append(parent);
    
    if (cell_count[0] * 100u < max_cells * 95u)
    {
        if (should_split(parent, id))
        {
            cell child = make_child(parent, id);
            cells_out.Append(child);
        }
    }
}

#pragma kernel build_depth_keys

RWStructuredBuffer<cell> cells;
RWStructuredBuffer<float> depth_keys;
RWStructuredBuffer<uint> depth_indices;

[numthreads(256, 1, 1)]
void build_depth_keys(uint id : SV_DispatchThreadID)
{
    if (id >= cell_count[0]) return;

    cell c = cells[id];

    float depth = dot(c.position - camera_pos, camera_forward);

    depth_keys[id] = depth;
    depth_indices[id]   = id;
}

#pragma kernel count_buckets

int3 grid_min;     // floor(bounds_min / bucket_size)
int3 grid_dim;     // grid_max - grid_min + 1

uint flatten_coord(int3 c)
{
    return (uint)(
          c.x
        + c.y * grid_dim.x
        + c.z * grid_dim.x * grid_dim.y
    );
}

RWStructuredBuffer<uint> bucket_count;

float bucket_size;

[numthreads(256,1,1)]
void count_buckets(uint id : SV_DispatchThreadID)
{
    if (id >= cell_count[0]) return;

    int3 bucket_coord = int3(floor(cells[id].position / bucket_size)) - grid_min;
    bucket_coord = clamp(bucket_coord, int3(0,0,0), grid_dim - 1);

    uint bucket = flatten_coord(bucket_coord);
    InterlockedAdd(bucket_count[bucket], 1);
}

#pragma kernel prefix_sum

RWStructuredBuffer<uint> bucket_start;

uint bucket_table_size; // grid_dim.x * grid_dim.y * grid_dim.z

[numthreads(256, 1, 1)]
void prefix_sum(uint id : SV_DispatchThreadID)
{
    if (id >= bucket_table_size) return;

    // TODO: This is a bit slow. Look into it
    uint sum = 0;
    for (uint i = 0; i < id; i++)
        sum += bucket_count[i];

    bucket_start[id] = sum;
}

#pragma kernel fill_buckets

RWStructuredBuffer<uint> bucket_indices;

[numthreads(256,1,1)]
void fill_buckets(uint id : SV_DispatchThreadID)
{
    if (id >= cell_count[0]) return;

    int3 bucket_coord = int3(floor(cells[id].position / bucket_size)) - grid_min;
    bucket_coord = clamp(bucket_coord, int3(0,0,0), grid_dim - 1);

    uint bucket = flatten_coord(bucket_coord);

    uint offset;
    InterlockedAdd(bucket_count[bucket], 1, offset);
    bucket_indices[bucket_start[bucket] + offset] = id;
}

#pragma kernel apply_forces

float air_pressure_strength;
float neighbor_radius;
float neighbor_radius_sq;
float repulsion_strength;

[numthreads(256, 1, 1)]
void apply_forces(uint id : SV_DispatchThreadID)
{
    if (id >= cell_count[0]) return;

    cell c = cells[id];
    
    // Air pressure force
    float origin_distance = length(c.position);
    float3 pressure_dir = (origin_distance > 0.0001)
        ? -c.position / origin_distance
        : 0;

    float3 accel = origin_distance * origin_distance
                    * air_pressure_strength
                    * pressure_dir;
    
    int3 base_bucket = int3(floor(c.position / bucket_size)) - grid_min;

    for (int z = -1; z <= 1; z++)
        for (int y = -1; y <= 1; y++)
            for (int x = -1; x <= 1; x++)
            {
                int3 nb = base_bucket + int3(x, y, z);

                // Skip out-of-bounds buckets
                if (any(nb < 0) || any(nb >= grid_dim))
                    continue;

                uint bucket = flatten_coord(nb);

                uint start = bucket_start[bucket];
                uint count = bucket_count[bucket];

                for (uint i = 0; i < count; i++)
                {
                    uint other_id = bucket_indices[start + i];
                    if (other_id == id) continue;

                    cell other = cells[other_id];

                    float3 delta = c.position - other.position;
                    float dist_sq = dot(delta, delta);

                    if (dist_sq > neighbor_radius_sq || dist_sq < 1e-6)
                        continue;

                    float dist = sqrt(dist_sq);
                    float3 dir = delta / dist;

                    float t = 1.0 - (dist / neighbor_radius);
                    float force = repulsion_strength * t * t;

                    accel += dir * force;
                }
            }
    
    // Integrate
    c.position += accel * delta_time;
    
    c.position = clamp(c.position, bounds_min, bounds_max);
    
    cells[id] = c;
}