#define THREAD_COUNT 1024
#pragma kernel CSMain

#include "Cell.hlsl"

StructuredBuffer<uint> cell_count;
StructuredBuffer<cell> cells_in;
AppendStructuredBuffer<cell> cells_out;

uint _MaxCells;
float _Time;
float _DeltaTime;
float4 _NewColour;
float4 _DeathColour;
float3 _CameraPos;
float3 _CameraForward;

uint hash(uint s)
{
    s ^= 2747636419u;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    return s;
}

float random(uint seed)
{
    return float(hash(seed)) / 4294967295.0;
}

bool ShouldSplit(cell c, uint id)
{
    float r = random(id + (uint)(_Time * 1000));
    float agePenalty = exp(-c.age * 0.5); // Rapid dropoff
    return r < 0.1 * agePenalty;
}

bool ShouldDie(cell c, uint id)
{
    float r = random(id + (uint)(_Time * 1000) + 12345); // decorrelate
    float ageFactor = 1.0 - exp(-c.age * 0.5); // 0 → 1 as age increases
    return r < 0.005 * ageFactor;
}

cell MakeChild(cell parent, uint id)
{
    cell child;
    child.age = 0;
    child.color = _NewColour;
    float3 offset = float3(
        random(id * 44317) - 0.5,
        random(id * 3231) - 0.5,
        random(id * 432457) - 0.5
    );
    child.position = parent.position + offset * 0.3;
    return child;
}

[numthreads(THREAD_COUNT, 1, 1)]
void CSMain(uint id : SV_DispatchThreadID)
{
    if (id >= _MaxCells)
    {
        return;
    }
    
    if (id >= cell_count[0])
    {
        return;
    }
    
    cell parent = cells_in[id];
    
    parent.age += _DeltaTime;

    if (ShouldDie(parent, id))
    {
        return;
    }
    
    if (parent.age > 5)
    {
        return;
    }
    
    float age_factor = exp(-parent.age * 1);
    parent.color = lerp(_DeathColour, _NewColour, age_factor);
    
    cells_out.Append(parent);

    // Optional split
    if (cell_count[0] < _MaxCells * 0.95)
    {
        if (ShouldSplit(parent, id))
        {
            cell child = MakeChild(parent, id);
            cells_out.Append(child);
        }
    }
}

StructuredBuffer<cell> cells;
RWStructuredBuffer<float> depthKeys;
RWStructuredBuffer<uint> indices;

#pragma kernel BuildDepthKeys

[numthreads(256, 1, 1)]
void BuildDepthKeys(uint id : SV_DispatchThreadID)
{
    if (id >= cell_count[0]) return;

    cell c = cells[id];

    float depth = dot(c.position - _CameraPos, _CameraForward);

    depthKeys[id] = depth;
    indices[id]   = id;
}
